# Environment variable template for the MVP (design-doc-mvp.md 8.2, H-8).
# Copy to .env.local for development. Never commit real values.
# Real secrets live only in Vercel Encrypted Environment Variables / CI secrets.

# Public. Canonical / OG / sitemap. Temporary canonical is
# https://dadriana-tienda.vercel.app until the definitive domain (Q-MVP-04).
NEXT_PUBLIC_SITE_URL=<VALUE>

# Secret. Local database or a synthetic Preview database only.
# Production DATABASE_URL is intentionally not created yet (Q-MVP-03, section 10.3).
DATABASE_URL=<VALUE>

# Secret. Authorized exception DD-MVP-21/22: HMAC pepper for reviews.
# Use a different value per environment; never public and never in app_config.
REVIEW_HASH_PEPPER=<VALUE>

# Rotation window only (DD-MVP-22): keep the previous pepper during rotation,
# then remove this line. It is NOT a permanent fourth variable.
# REVIEW_HASH_PEPPER_PREVIOUS=<VALUE>

# NOTE: WhatsApp number, social links, stores and curated selections are read
# from app_config in PostgreSQL, NOT from environment variables.
# No payment, DIAN, GA4 or Sentry variables apply to this MVP.
