{
  "name": "dadriana-tienda",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'prototipo/**'",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:fixtures": "node prisma/fixtures.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:dynamic": "playwright test --config playwright.dynamic.config.ts",
    "test:a11y": "playwright test --grep @a11y",
    "check:bundle": "node scripts/check-bundle.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.5",
    "next": ">=15.5.29 <16",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "0.0.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.12",
    "axe-core": "^4.14.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.29",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.33",
    "deepmerge-ts": "^8.0.2",
    "effect": "^3.22.5"
  },
  "eslintConfig": {
    "extends": [
      "next/core-web-vitals",
      "next/typescript"
    ],
    "rules": {
      "@next/next/no-html-link-for-pages": "off"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
